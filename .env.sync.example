# Copiar a .env / variables de entorno de Windows — NO subir tokens al git.
# En Vercel / .env.local del sistema integrado:
#   PRECIX_SYNC_TOKEN=<mismo-token>
#   PRECIX_DEFAULT_PLANTA=ATE-EXTRUSORA-1
#
# UI nube: Producción → Reportes de producción (pesajes)
#   ruta: /operaciones/produccion/pesajes

PRECIX_SYNC_ENABLED=1
PRECIX_SYNC_URL=https://tu-dominio.vercel.app/api/v1/precix/pesajes
PRECIX_SYNC_TOKEN=pegar-aqui-el-mismo-token-que-en-Vercel
PRECIX_DEFAULT_PLANTA=ATE-EXTRUSORA-1
PRECIX_SYNC_INTERVAL_MIN=5
